# Vexa Backend – Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection string (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vexa?retryWrites=true&w=majority

# AI API Keys (Choose any ONE - Free options available!):
# 1. Google Gemini API Key (100% Free at https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# 2. Or Groq API Key (Free at https://console.groq.com/)
# GROQ_API_KEY=gsk_...

# 3. Or OpenAI API Key (from https://platform.openai.com/)
# OPENAI_API_KEY=sk-...

# Port (optional, defaults to 8080)
PORT=8080

